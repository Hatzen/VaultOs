# ============================================================================
# VaultOs Local Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your workstation.
# Never commit .env to version control.
# ============================================================================

# --- Local Repository Paths (defaults to relative paths from VaultOs root) ---
CUSTOM_OTTER_DIR=../../AndroidStudioProjects/CustomOtterControl
PARANNOYING_DIR=../../StudioProjects/ParAnnoying
VENDOR_VAULTOS_DIR=../android_vendor_vaultos
DEVICE_OTTER_DIR=../android_device_shift_otter
KERNEL_OTTER_DIR=../android_kernel_shift_qcm6490
VAULTOS_CONCEPT_DIR=../vaultos-concept

# --- Remote AOSP/LineageOS Build Machine (Optional, for SSH/Lima builders) ---
BUILD_SSH_HOST=build-host.local
BUILD_SSH_USER=builder
BUILD_LIMA_INSTANCE=android-build
BUILD_REMOTE_ROOT=/home/builder.guest/lineage-build

# --- Release Publishing (Optional) ---
GITHUB_REPO=Hatzen/VaultOs
# GITHUB_TOKEN=ghp_your_personal_access_token_here
