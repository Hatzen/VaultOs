<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Definiert die verfügbaren Netzwerk-Typen. Komplett leer lassen! -->
    <string-array translatable="false" name="networkAttributes"></string-array>

    <!-- Definiert die Radio-Attribute. Ebenfalls komplett leer lassen! -->
    <string-array translatable="false" name="radioAttributes"></string-array>

    <!-- Dem System sagen, dass es kein WLAN besitzt -->
    <bool name="config_wlan_data_service_supported">false</bool>
    <bool name="config_wifi_dual_sap_mode_supported">false</bool>

    <!-- Dem System sagen, dass es keine Telefonie/Modem besitzt -->
    <bool name="config_voice_capable">false</bool>
    <bool name="config_sms_capable">false</bool>
    <bool name="config_show_emergency_subid_only">false</bool>

     <!-- Deaktiviert die Erlaubnis für Hintergrund-Netzwerkscans komplett -->
    <bool name="config_background_networks_disabled">true</bool>

    <!-- Blockiert das automatische Aufwachen (Wakelocks) bei Verbindungsänderungen -->
    <bool name="config_restart_radio_on_pdp_fail_regular_deactivation">false</bool>

    <!-- Sagt dem Akku-Manager, dass kein Funkmodul (Mobilfunk) Strom verbrauchen darf -->
    <string name="config_radio_access_family" translatable="false">0</string>
</resources>